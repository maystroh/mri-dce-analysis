# Copy to .env and adjust. Docker Compose reads it automatically.

# Owner of the files written to OUT_DIR (run `id -u` and `id -g`).
UID=1000
GID=1000

# Host folder with your exams (mounted read-only at /data).
DATA_DIR=./data
# Host folder for results (mounted at /out).
OUT_DIR=./results

# Viewer: result folder name under OUT_DIR, host port, bind address.
RUN_DIR=example_duke
VIEWER_PORT=8060
VIEWER_BIND=127.0.0.1
